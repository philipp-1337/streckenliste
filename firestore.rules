rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Push-Geräte werden ausschließlich serverseitig über Cloud Functions
    // verwaltet. Kein Client darf Tokens lesen oder schreiben.
    match /push_devices/{deviceId} {
      allow read, write: if false;
    }

    // Verarbeitungsnachweise der Push-Events gegen Doppelzustellung. Rein
    // serverseitig; braucht eine Firestore-TTL-Policy auf expiresAt, sonst
    // wächst die Collection unbegrenzt.
    match /push_events/{eventId} {
      allow read, write: if false;
    }

    // Helper function to get the current user's data from the /users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth != null && getUserData().get('role', '') == 'admin';
    }

    function isOwnUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Spiegelt die Eigentümer-Prüfung der update/delete-Regeln für Einträge.
    // Bewusst ohne userId-Vergleich als alleinigen Treffer: userId benennt in
    // den Altdaten den Eintragenden, nicht den Eigentümer.
    function ownsEntryData(data, jagdbezirkId) {
      return data.get('userId', '') == request.auth.uid ||
        (
          data.get('jaegerId', '') != '' &&
          data.get('jaegerId', '') == getAssignedJaegerId(jagdbezirkId)
        );
    }

    // Regeln werten jeden Write eines Batches gegen den Stand VOR dem Commit
    // aus. Daraus folgt für Nicht-Admins pro Aktion eine exakte Erwartung:
    //
    //   created  – der Eintrag entsteht im selben Batch, existiert also noch
    //              nicht. Ein vorhandener Eintrag bedeutet: eigenständiges
    //              History-Dokument ohne echte Anlage.
    //   updated  – der Eintrag existiert und gehört dem Nutzer.
    //   deleted  – der Eintrag existiert noch (er wird im selben Batch
    //              gelöscht) und gehört dem Nutzer.
    //
    // Die created-Bedingung ist der Kern: ohne sie kann ein Member unter seinem
    // eigenen pending-Eintrag beliebig oft eine Anlage behaupten, ohne etwas zu
    // ändern – und das erreicht Admins auf jeder Benachrichtigungsstufe.
    function memberMayLogHistory(jagdbezirkId, eintragId, action) {
      let entryPath = /databases/$(database)/documents/jagdbezirke/$(jagdbezirkId)/eintraege/$(eintragId);
      return action == 'created'
        ? !exists(entryPath)
        : (
            action in ['updated', 'deleted'] &&
            exists(entryPath) &&
            ownsEntryData(get(entryPath).data, jagdbezirkId)
          );
    }

    function getAssignedJaegerId(jagdbezirkId) {
      let assignmentPath = /databases/$(database)/documents/jagdbezirke/$(jagdbezirkId)/userAssignments/$(request.auth.uid);
      return exists(assignmentPath)
        ? get(assignmentPath).data.get('jaegerId', '')
        : getUserData().get('jaegerId', '');
    }

    // Validate entry data structure and content
    function isValidEntry(jagdbezirkId) {
      let data = request.resource.data;
      return data.keys().hasAll(['datum', 'wildart', 'userId', 'jagdbezirkId'])
        && data.datum is string
        && data.datum.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.wildart is string
        && data.wildart.size() > 0
        && data.wildart.size() <= 100
        && data.userId is string
        // Das Feld muss den Bezirk des Pfads benennen, sonst entstehen
        // Einträge, deren Feldwert auf einen fremden Bezirk zeigt.
        && data.jagdbezirkId == jagdbezirkId
        && (!data.keys().hasAny(['jaegerId']) || data.jaegerId is string)
        && (!data.keys().hasAny(['gewicht']) || data.gewicht is string)
        && (!data.keys().hasAny(['einnahmen']) || data.einnahmen is string)
        && (!data.keys().hasAny(['ausgaben']) || data.ausgaben is string)
        && (!data.keys().hasAny(['geschlecht']) || data.geschlecht is string)
        && (!data.keys().hasAny(['altersklasse']) || data.altersklasse is string)
        && (!data.keys().hasAny(['kategorie']) || data.kategorie is string)
        && (!data.keys().hasAny(['notizen']) || (data.notizen is string && data.notizen.size() <= 1000))
        && (!data.keys().hasAny(['timestamp']) || data.timestamp is timestamp)
        && (!data.keys().hasAny(['status']) || data.status in ['pending', 'approved', 'rejected'])
        && (!data.keys().hasAny(['ablehnungsGrund']) || data.ablehnungsGrund is string);
    }

    // Users can read/update their own profile
    // Admins can manage users in their own Jagdbezirk
    match /users/{userId} {
      allow read: if isOwnUser(userId);
      // Admin: nur Nutzer des eigenen Bezirks. Die App fragt mit
      // where('jagdbezirkId', '==', eigenerBezirk) an, die Regel macht daraus
      // eine harte Grenze statt einer App-Konvention.
      allow read: if isAdmin() &&
                    resource.data.get('jagdbezirkId', '') == getUserData().jagdbezirkId;
      // User-Dokumente entstehen ausschließlich serverseitig über die
      // Cloud Functions createBezirkUser/createJagdbezirk (Admin SDK
      // umgeht die Rules). Kein Client darf sie anlegen.
      allow create: if false;
      // Users may update their own display data but not role, district, or jaeger assignment.
      // Admins may update users in their own Jagdbezirk; jagdbezirkId ist für
      // alle unveränderlich. Der Abgleich läuft gegen den BESTEHENDEN Bezirk
      // des Ziels — gegen den Request-Wert könnte ein fremder Admin einen
      // Nutzer in den eigenen Bezirk „ziehen".
      allow update: if
                    request.resource.data.jagdbezirkId == resource.data.jagdbezirkId &&
                    (
                      (
                        isOwnUser(userId) &&
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.get('jaegerId', '') == resource.data.get('jaegerId', '')
                      ) ||
                      (
                        isAdmin() &&
                        getUserData().jagdbezirkId == resource.data.get('jagdbezirkId', '')
                      )
                    );
      // Deaktivierung läuft ausschließlich serverseitig über die Cloud
      // Function deactivateBezirkUser (Admin SDK umgeht die Rules) — die
      // sperrt zusätzlich den Auth-Account. Ein reines Client-Delete des
      // Dokuments ließe den Account aktiv und anmeldbar zurück.
      allow delete: if false;
    }

    // Jagdbezirk document itself (for metadata)
    match /jagdbezirke/{jagdbezirkId} {
      // Any user in the district can read its metadata
    allow read: if request.auth != null && getUserData().jagdbezirkId == jagdbezirkId;
      // Nur Admins des eigenen Bezirks dürfen dessen Metadaten ändern.
      // Neue Bezirke entstehen bewusst nicht über den Client, sondern nur
      // über Konsole/Backoffice.
    allow write: if isAdmin() && getUserData().jagdbezirkId == jagdbezirkId;

      match /jaeger/{jaegerId} {
        allow read: if request.auth != null && getUserData().jagdbezirkId == jagdbezirkId;
        allow write: if isAdmin() && getUserData().jagdbezirkId == jagdbezirkId;
      }

      match /userAssignments/{userId} {
        allow read: if (request.auth != null && request.auth.uid == userId && getUserData().jagdbezirkId == jagdbezirkId) ||
                      (isAdmin() && getUserData().jagdbezirkId == jagdbezirkId);
        allow write: if isAdmin() && getUserData().jagdbezirkId == jagdbezirkId;
      }
    }

    // Entries within a Jagdbezirk
    match /jagdbezirke/{jagdbezirkId}/eintraege/{eintragId} {
      allow read: if request.auth != null && (
        (getUserData().get('jagdbezirkId', '') == jagdbezirkId && getUserData().get('role', '') == 'admin') ||
        resource.data.userId == request.auth.uid ||
        (
          getUserData().get('jagdbezirkId', '') == jagdbezirkId &&
          'jaegerId' in resource.data &&
          resource.data.jaegerId != ''
        )
      );

      // Allow create if user belongs to the district and sets their own userId
      // Users must set status='pending' and their fixed jaegerId; admins may set status='approved'
    allow create: if request.auth != null &&
             getUserData().get('jagdbezirkId', '') == jagdbezirkId &&
             request.resource.data.userId == request.auth.uid &&
             isValidEntry(jagdbezirkId) &&
             (
               isAdmin() ||
               (
                 getAssignedJaegerId(jagdbezirkId) is string &&
                 getAssignedJaegerId(jagdbezirkId).size() > 0 &&
                 request.resource.data.get('status', 'pending') == 'pending' &&
                 request.resource.data.get('jaegerId', '') == getAssignedJaegerId(jagdbezirkId)
               )
             );

      // Allow update if user is admin OR owns the entry
      // Only admins may change status to 'approved' or 'rejected', or write ablehnungsGrund
    allow update: if request.auth != null &&
             getUserData().get('jagdbezirkId', '') == jagdbezirkId &&
             (isAdmin() || resource.data.userId == request.auth.uid || 
               ('jaegerId' in resource.data && resource.data.jaegerId == getAssignedJaegerId(jagdbezirkId))
             ) &&
             isValidEntry(jagdbezirkId) &&
             (isAdmin() ||
              (
                request.resource.data.get('status', 'pending') != 'approved' &&
                request.resource.data.get('status', 'pending') != 'rejected' &&
                !request.resource.data.keys().hasAny(['ablehnungsGrund']) &&
                (request.resource.data.userId == request.auth.uid || request.resource.data.userId == resource.data.userId) &&
                request.resource.data.get('jaegerId', '') == getAssignedJaegerId(jagdbezirkId)
              ));

      // Allow delete if user is admin OR owns the entry (no data validation needed)
    allow delete: if request.auth != null &&
             getUserData().get('jagdbezirkId', '') == jagdbezirkId &&
             (isAdmin() || resource.data.userId == request.auth.uid || 
               ('jaegerId' in resource.data && resource.data.jaegerId == getAssignedJaegerId(jagdbezirkId))
             );

      // Änderungsverlauf – nur Admin kann lesen, History-Einträge sind unveränderlich
      match /history/{historyId} {
        allow read: if request.auth != null &&
                 getUserData().jagdbezirkId == jagdbezirkId &&
                 isAdmin();
        // Der Änderungsverlauf ist die Quelle für Push-Benachrichtigungen. Ein
        // frei beschreibbarer Verlauf hieße deshalb: jeder im Bezirk kann
        // beliebige Benachrichtigungen an Admins und fremde Jäger auslösen und
        // dabei Vorgänge behaupten, die nie passiert sind.
        //
        // Firestore-Rules können nicht prüfen, ob im selben Batch auch der
        // Eltern-Eintrag geschrieben wurde – jeder Write eines Batches wird
        // einzeln bewertet. Prüfbar ist aber, ob der Nutzer den Eintrag
        // überhaupt ändern dürfte, und das ist die eigentlich relevante Frage.
        allow create: if request.auth != null &&
                 getUserData().jagdbezirkId == jagdbezirkId &&
                 request.resource.data.keys().hasAll(['timestamp', 'changedByUid', 'changedByName', 'action']) &&
                 request.resource.data.action in ['created', 'updated', 'approved', 'rejected', 'reset_to_pending', 'deleted'] &&
                 // Kein Protokollieren im Namen anderer.
                 request.resource.data.changedByUid == request.auth.uid &&
                 (
                   isAdmin() ||
                   (
                     // Statuswechsel sind Admin-Vorgänge. Ohne diese Grenze
                     // könnte ein Member eine Ablehnung oder Freigabe erfinden.
                     request.resource.data.action in ['created', 'updated', 'deleted'] &&
                     memberMayLogHistory(jagdbezirkId, eintragId, request.resource.data.action)
                   )
                 );
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
