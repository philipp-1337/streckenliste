{
  "name": "streckenliste",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "dev:emulator": "VITE_USE_EMULATOR=true bunx --bun vite",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "build": "bun run tsc -b && bunx --bun vite build",
    "lint": "bunx eslint .",
    "test": "bun test src",
    "test:rules": "firebase emulators:exec --only firestore 'node --test tests/firestore-rules.test.mjs'",
    "preview": "bunx --bun vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "firebase": "^12.15.0",
    "html-to-image": "^1.11.13",
    "isomorphic-dompurify": "^3.18.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1"
  }
}
